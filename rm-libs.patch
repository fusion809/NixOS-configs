+lfs_cleanup_old_libs() {
+    # Only source SSH helpers when running on the host
+    [[ -f "$NIXCFG/shell/user/08-ssh.sh" ]] && source "$NIXCFG/shell/user/08-ssh.sh"
+    [[ -f "$NIXCFG/shell/user/18-vms.sh" ]] && source "$NIXCFG/shell/user/18-vms.sh" >/dev/null 2>&1
+
+    echo "Scanning /usr/lib on VM for old library versions..."
+    local old_libs=$(ssh_lfs "cat > /tmp/find_old_libs.py << 'EOF'
+import os
+import re
+from collections import defaultdict
+
+lib_dir = '/usr/lib'
+libs = defaultdict(list)
+
+# Find all .so files
+for f in os.listdir(lib_dir):
+    if '.so.' in f and not os.path.islink(os.path.join(lib_dir, f)):
+        m = re.match(r'^(.*?\.so)\.(.+)$', f)
+        if m:
+            base, ver = m.groups()
+            version_parts = []
+            valid_version = True
+            for part in ver.split('.'):
+                if part.isdigit():
+                    version_parts.append(int(part))
+                else:
+                    valid_version = False
+                    break
+            if valid_version and version_parts:
+                libs[base].append((version_parts, f))
+
+old_libs = []
+for base, versions in libs.items():
+    if len(versions) > 1:
+        sorted_versions = sorted(versions, key=lambda x: x[0])
+        # Only the highest version is the 'current' one
+        for ver_tuple, f in sorted_versions[:-1]:
+            old_libs.append(os.path.join(lib_dir, f))
+
+for lib in sorted(old_libs):
+    print(lib)
+EOF
+python3 /tmp/find_old_libs.py && rm -f /tmp/find_old_libs.py")
+
+    if [[ -z "$old_libs" ]]; then
+        echo "No old libraries found."
+        return 0
+    fi
+
+    local old_libs_arr=()
+    while IFS= read -r lib; do
+        [[ -n "$lib" ]] && old_libs_arr+=("$lib")
+    done <<< "$old_libs"
+
+    echo "Found ${#old_libs_arr[@]} old libraries. Checking for dependents..."
+    local pkgs_to_rebuild=()
+    local libs_to_delete=()
+
+    for lib in "${old_libs_arr[@]}"; do
+        local lib_name=$(basename "$lib")
+        local dependents=$(ssh_lfs "missing_search \"$lib_name\" 2>/dev/null")
+        
+        if [[ -n "$dependents" ]]; then
+            echo "  $lib_name is in use by dependents. Added to rebuild queue."
+            while IFS= read -r dep_bin; do
+                [[ -z "$dep_bin" ]] && continue
+                local dep_pkg=$(lfs_map_bin_to_pkg "$dep_bin")
+                if [[ -n "$dep_pkg" ]]; then
+                    # Add to array if not already there
+                    local already_in=false
+                    for p in "${pkgs_to_rebuild[@]}"; do
+                        if [[ "$p" == "$dep_pkg" ]]; then already_in=true; break; fi
+                    done
+                    if [[ "$already_in" == "false" ]]; then
+                        echo "    Requires rebuild: $dep_pkg"
+                        pkgs_to_rebuild+=("$dep_pkg")
+                    fi
+                fi
+            done <<< "$dependents"
+        else
+            echo "  $lib_name has no dependents. Safe to delete."
+        fi
+        libs_to_delete+=("$lib")
+    done
+
+    if [[ ${#pkgs_to_rebuild[@]} -gt 0 ]]; then
+        echo ""
+        echo "Rebuilding required packages (${#pkgs_to_rebuild[@]})..."
+        lfs_autobuild "${pkgs_to_rebuild[@]}"
+    fi
+
+    if [[ ${#libs_to_delete[@]} -gt 0 ]]; then
+        echo ""
+        echo "Verifying it is safe to delete old libraries..."
+        for lib in "${libs_to_delete[@]}"; do
+            local lib_name=$(basename "$lib")
+            local dependents=$(ssh_lfs "missing_search \"$lib_name\" 2>/dev/null")
+            if [[ -z "$dependents" ]]; then
+                echo "  Deleting $lib..."
+                ssh_lfs "sudo rm -f \"$lib\""
+            else
+                echo "  WARNING: $lib is STILL in use by $(echo "$dependents" | wc -w) binaries. Keeping it."
+            fi
+        done
+    fi
+    echo "Old library cleanup complete."
+}
