-                    echo "$candidate" | sudo tee -a "/tmp/preserved_libs_${PACKAGE}.txt" > /dev/null
+                [ -f "$candidate" ] && [ "$candidate" != "$line" ] || continue
+                if ! [[ "$candidate" -nt /tmp/build_start_timestamp_${PACKAGE} ]]; then
+                    cand_base=$(basename "$candidate")
+                    if [ -n "$major_prefix" ] && [[ "$cand_base" == "${major_prefix##*/}"* ]]; then
+                        # Same major version family → old micro version, remove it
+                        echo "Removing old library version: $candidate"
+                        rm -f "$candidate"
+                    else
+                        # Different major version → preserved (another pkg may need it)
+                        echo "Found preserved library: $candidate"
+                        echo "$candidate" | sudo tee -a "/tmp/preserved_libs_${PACKAGE}.txt" > /dev/null
+                    fi
                 fi
             done
         fi
@@ -1862,7 +1874,9 @@ while read -r line; do
                      rm -rf "$candidate"
