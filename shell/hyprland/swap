#!/usr/bin/env bash

# Get non-zram swap info from /proc/swaps
swap_stats=$(grep -v "zram" /proc/swaps | tail -n +2)

if [[ -z "$swap_stats" ]]; then
    perc=0
else
    total_size=0
    total_used=0
    while read -r filename type size used priority; do
        total_size=$((total_size + size))
        total_used=$((total_used + used))
    done <<< "$swap_stats"

    if [[ "$total_size" -eq 0 ]]; then
        perc=0
    else
        perc=$(( total_used * 100 / total_size ))
    fi
fi

# Determine class based on usage (matching memory logic)
if (( perc >= 90 )); then
    class="critical"
elif (( perc >= 75 )); then
    class="high"
elif (( perc >= 50 )); then
    class="medium"
elif (( perc >= 25 )); then
    class="low"
else
    class="idle"
fi

# Output JSON with padding (matching memory's %2d%%)
# This will be " 5%" or "10%" or "100%"
printf '{"text":"%2d%%","class":"%s"}' $perc "$class"
