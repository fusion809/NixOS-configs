#!/usr/bin/env zsh

MODE="${1:-combined}"
LOGFILE="$HOME/.cache/gpu_graph.log"

# Detect GPU for title
GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader,nounits | head -n 1)
if [[ -z "$GPU_NAME" ]]; then GPU_NAME="NVIDIA GPU"; fi

# Configure paths and plot based on mode
if [[ "$MODE" == "utilization" ]]; then
    mkdir -p "$HOME/.cache/graphs/gpu/utilization"
    IMGFILE="$HOME/.cache/graphs/gpu/utilization/graph.png"
    PLOT_TITLE="GPU utilization ($GPU_NAME)"
    # Filter valid timestamps > 2020 (1.6e9)
    DATA_SRC="< awk '\$1 > 1600000000' $LOGFILE"
    # Plot column 2 (Utilization)
    PLOT_CMD="plot \"$DATA_SRC\" using (\$1 + offset_sec):2 title \"Utilization (%)\" with lines lw 3 lc rgb \"green\""
    YLABEL="Utilization (%)"
elif [[ "$MODE" == "memory" ]]; then
    mkdir -p "$HOME/.cache/graphs/gpu/memory"
    IMGFILE="$HOME/.cache/graphs/gpu/memory/graph.png"
    PLOT_TITLE="GPU memory usage ($GPU_NAME)"
    DATA_SRC="< awk '\$1 > 1600000000' $LOGFILE"
    # Plot calculated percentage: ($3 / $4) * 100
    PLOT_CMD="plot \"$DATA_SRC\" using (\$1 + offset_sec):((\$3/\$4)*100) title \"Memory usage (%)\" with lines lw 3 lc rgb \"blue\""
    YLABEL="Memory usage (%)"
else
    mkdir -p "$HOME/.cache/graphs/gpu/combined"
    IMGFILE="$HOME/.cache/graphs/gpu/combined/graph.png"
    PLOT_TITLE="GPU statistics ($GPU_NAME)"
    DATA_SRC="< awk '\$1 > 1600000000' $LOGFILE"
    PLOT_CMD="plot \"$DATA_SRC\" using (\$1 + offset_sec):2 title \"Utilization (%)\" with lines lw 3 lc rgb \"green\", \"$DATA_SRC\" using (\$1 + offset_sec):((\$3/\$4)*100) title \"Memory usage (%)\" with lines lw 3 lc rgb \"blue\""
    YLABEL="Percentage (%)"
fi

# Timezone offset
offset_str=$(date +%z)
sign="${offset_str:0:1}"
h="${offset_str:1:2}"
m="${offset_str:3:2}"
offset_sec=$(( 10#$h * 3600 + 10#$m * 60 ))
if [[ "$sign" == "-" ]]; then offset_sec=$(( -offset_sec )); fi

# Graphing Function
generate_graph() {
    if [[ ! -s "$LOGFILE" ]]; then return 1; fi
    
    # Calculate optimal xtics step
    local start_ts=$(awk '$1 > 1600000000 {print $1; exit}' "$LOGFILE")
    local last_ts=$(awk 'END {print $1}' "$LOGFILE")
    
    if [[ -z "$start_ts" || -z "$last_ts" ]]; then return 1; fi
    
    local duration=$(( last_ts - start_ts ))
    local step=$(( duration / 10 ))
    if (( step < 60 )); then step=60; fi
    
    local format_str="%I:%M %p"
    if (( duration > 86400 )); then
        format_str="%d/%m\\n%I:%M %p"
    fi
    
    gnuplot -e "
        offset_sec = $offset_sec;
        set title \"$PLOT_TITLE\";
        set xdata time;
        set timefmt \"%s\";
        set format x \"$format_str\";
        set xtics rotate by -45 $step;
        set xlabel \"Time\";
        set ylabel \"$YLABEL\";
        set yrange [0:100];
        set key outside;
        set grid;
        set term pngcairo size 1000,700 font \"monospace,16\";
        set output \"${IMGFILE}.tmp\";
        $PLOT_CMD;
    "
    mv "${IMGFILE}.tmp" "$IMGFILE"
}

# Wait for log file
while [[ ! -f "$LOGFILE" ]]; do
    sleep 1
done

# Initial generation
generate_graph

# Open EOG
if command -v gwenview &> /dev/null; then
    if [[ -f "$IMGFILE" ]]; then
        gwenview "$IMGFILE" &
        GWENVIEW_PID=$!
    else
        notify-send "Graph Error" "Failed to generate graph image."
        exit 1
    fi
else
    notify-send "Error" "gwenview not found."
    exit 1
fi

# Main Loop: Update Graph
while kill -0 "$GWENVIEW_PID" 2> /dev/null; do
    sleep 2
    generate_graph
done
