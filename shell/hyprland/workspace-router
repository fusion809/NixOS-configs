#!/usr/bin/env bash

# Use a lock file to ensure only one instance runs
exec 200>/tmp/workspace-router.lock
flock -n 200 || exit 1

LOGFILE="/tmp/workspace-router.log"
echo "--- Starting Workspace Router at $(date) ---" > "$LOGFILE"

# Active socket detection
SOCKET=$(find /run/user/1000/hypr /tmp/hypr -name ".socket2.sock" -type s -printf "%T@ %p\n" 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2)

if [ -z "$SOCKET" ]; then
    echo "ERROR: Could not find Hyprland socket2.sock!" >> "$LOGFILE"
    exit 1
fi

echo "Connected to socket: $SOCKET" >> "$LOGFILE"

HYPRCTL="$HOME/GitHub/mine/config/NixOS-configs/shell/hyprland/tools/hyprctl-fixed.sh"

# Dispatch helpers — automatically use Lua API when hyprland.lua is active,
# otherwise fall back to plain hyprctl dispatch commands.
dispatch_move() {
    local workspace="$1"
    local address="$2"
    if [[ -f "$HOME/.config/hypr/hyprland.lua" ]]; then
        "$HYPRCTL" eval "hl.dispatch(hl.dsp.window.move({ workspace = $workspace, window = 'address:0x$address', silent = true }))"
    else
        "$HYPRCTL" dispatch movetoworkspacesilent "$workspace,address:0x$address"
    fi
}

dispatch_focus() {
    local workspace="$1"
    if [[ -f "$HOME/.config/hypr/hyprland.lua" ]]; then
        "$HYPRCTL" eval "hl.dispatch(hl.dsp.focus({ workspace = $workspace }))"
    else
        "$HYPRCTL" dispatch workspace "$workspace"
    fi
}

handle() {
  # Clean up input and log everything for debugging
  local line=$(echo "$1" | tr -cd '[:print:]')
  
  local w_address=""
  local w_class=""
  local w_title=""
  
  if [[ "$line" == openwindow\>\>* ]]; then
    local payload="${line#openwindow>>}"
    IFS=',' read -r w_address w_wsid w_class w_title <<< "$payload"
  elif [[ "$line" == openwindowv2\>\>* ]]; then
    local payload="${line#openwindowv2>>}"
    IFS=',' read -r w_address w_wsid w_wsname w_class w_title <<< "$payload"
  fi

  # If we have a window event, process it
  if [[ -n "$w_address" ]]; then
    echo "Event: $line" >> "$LOGFILE"
    
    # Helper to check if a window is floating
    is_floating() {
        "$HYPRCTL" clients -j | jq -e -r --arg addr "0x$w_address" '.[] | select(.address == $addr) | .floating'
    }

    local target=""

    if [[ "$w_class" =~ brave-browser ]]; then
        if is_floating; then return; fi
        if [[ "$w_title" == "New Private Tab - Brave" ]]; then
            target=27
        else
            target=15
        fi
        dispatch_move "$target" "$w_address"

    elif [[ "$w_class" =~ vlc ]]; then
       if is_floating; then return; fi
       (
           local count_25=$("$HYPRCTL" workspaces -j | jq 'map(select(.id == 25)) | .[0].windows // 0')
           local count_26=$("$HYPRCTL" workspaces -j | jq 'map(select(.id == 26)) | .[0].windows // 0')
           local t=""
           
           if [ "$count_25" -eq 0 ]; then
               t=25
           elif [ "$count_26" -eq 0 ]; then
               t=26
           elif [ "$count_25" -le "$count_26" ]; then
               t=25
           else
               t=26
           fi
           dispatch_move "$t" "$w_address"
       ) &

    elif [[ "$w_class" =~ google-chrome ]]; then
       if is_floating; then return; fi
       (
            if [[ -z "$w_title" ]] || [[ "$w_title" == "Untitled - Google Chrome" ]] || [[ "$w_title" == "New tab - Google Chrome" ]] || [[ "$w_title" == "Google Chrome" ]] || [[ "$w_title" == "Restore pages?" ]]; then
                sleep 3.0
                w_title=$("$HYPRCTL" clients -j | jq -r --arg addr "0x$w_address" '.[] | select(.address == $addr) | .title')
            fi
           
           echo "Chrome Routing Match: addr=0x$w_address class=$w_class title=$w_title" >> "$LOGFILE"

           if [[ "$w_title" == *"PBS Job"* ]] || [[ "$w_title" == *"u1126705@umail.usq.edu.au"* ]]; then
               dispatch_move 7 "$w_address"
           elif [[ "$w_title" == *"Boo"* ]]; then
               dispatch_move 12 "$w_address"
           else
               local count_1=$("$HYPRCTL" workspaces -j | jq 'map(select(.id == 1)) | .[0].windows // 0')
               local existing_title_1=$("$HYPRCTL" clients -j | jq -r 'map(select(.workspace.id == 1 and .class == "google-chrome")) | .[0].title // ""')
               
               if [ "$count_1" -eq 0 ] || [[ -z "$existing_title_1" ]] || [[ "$existing_title_1" == "New tab - Google Chrome" ]]; then
                    dispatch_move 1 "$w_address"
                else
                    local choice=$(echo -e "Current\n1(main)\n7(PBS)\n12(Boo)" | rofi -dmenu -p "Select Workspace for Chrome:")
                    if [[ -n "$choice" ]] && [[ "$choice" != "Current" ]]; then
                        local t=$(echo "$choice" | cut -d '(' -f 1)
                        dispatch_move "$t" "$w_address"
                    elif [[ -z "$choice" ]]; then
                        dispatch_move 1 "$w_address"
                    fi
                fi
            fi
       ) &

    elif [[ "$w_class" =~ virt-viewer ]] || ( [[ "$w_class" =~ .virt-manager-wrapped ]] && [[ "$w_title" != "Virtual Machine Manager" ]] ); then
       (
           if is_floating; then exit 0; fi

           local count_28=$("$HYPRCTL" workspaces -j | jq 'map(select(.id == 28)) | .[0].windows // 0')
           local count_29=$("$HYPRCTL" workspaces -j | jq 'map(select(.id == 29)) | .[0].windows // 0')
           local count_30=$("$HYPRCTL" workspaces -j | jq 'map(select(.id == 30)) | .[0].windows // 0')
           local count_31=$("$HYPRCTL" workspaces -j | jq 'map(select(.id == 31)) | .[0].windows // 0')
           local t=""
           
           if [ "$count_28" -eq 0 ]; then
               t=28
           elif [ "$count_29" -eq 0 ]; then
               t=29
           elif [ "$count_30" -eq 0 ]; then
               t=30
           elif [ "$count_31" -eq 0 ]; then
               t=31
           else
               local choice=$(echo -e "Current\n28\n29\n30\n31" | rofi -dmenu -p "Select Workspace for virt-viewer:")
               if [[ -n "$choice" ]] && [[ "$choice" != "Current" ]]; then
                   t="$choice"
               elif [[ "$choice" == "Current" ]]; then
                   exit 0
               fi
           fi

           if [[ -n "$t" ]]; then
               dispatch_move "$t" "$w_address"
               dispatch_focus "$t"
           fi
       ) &

    elif [[ "$w_class" =~ steam_app_1343400 ]]; then
       if is_floating; then return; fi
       (
           local t=8
           dispatch_move "$t" "$w_address"
       ) &
      fi
  fi
}

# Infinite loop to keep connection alive
while true; do
    nc -U "$SOCKET" | while read -r line; do
        handle "$line"
    done
    echo "DEBUG: Connection lost. Reconnecting..." >> "$LOGFILE"
    sleep 1
done &
