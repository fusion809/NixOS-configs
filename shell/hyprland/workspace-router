#!/usr/bin/env bash

# Find the socket path correctly whether using /tmp/hypr or $XDG_RUNTIME_DIR/hypr
if [ -S "$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" ]; then
    SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
else
    SOCKET="/tmp/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
fi

LOGFILE="/tmp/workspace-router.log"

handle() {
  echo "Event: $1" >> "$LOGFILE"
  if [[ "$1" == openwindow\>\>* ]]; then
    local payload="${1#openwindow>>}"
    # Use comma as delimiter, but title can contain commas
    IFS=',' read -r w_address w_workspace w_class w_title <<< "$payload"
    echo "Payload: address=$w_address, workspace=$w_workspace, class=$w_class, title=$w_title" >> "$LOGFILE"
    
    if [[ "$w_class" == "brave-browser" ]]; then
        if [[ "$w_title" == "New Private Tab - Brave" ]]; then
            target=27
        else
            target=15
        fi
        hyprctl dispatch movetoworkspacesilent "$target,address:0x$w_address"

    elif [[ "$w_class" == "vlc" ]]; then
       (
           count_25=$(hyprctl workspaces -j | jq 'map(select(.id == 25)) | .[0].windows // 0')
           count_26=$(hyprctl workspaces -j | jq 'map(select(.id == 26)) | .[0].windows // 0')
           
           if [ "$count_25" -eq 0 ]; then
               target=25
           elif [ "$count_26" -eq 0 ]; then
               target=26
           elif [ "$count_25" -le "$count_26" ]; then
               target=25
           else
               target=26
           fi
           hyprctl dispatch movetoworkspacesilent "$target,address:0x$w_address"
       ) &

    elif [[ "$w_class" == "google-chrome" ]]; then
       (
           # Priority routing for specific titles
           if [[ "$w_title" == *"PBS Job"* ]] || [[ "$w_title" == *"u1126705@umail.usq.edu.au"* ]]; then
               chrome_on_7=$(hyprctl clients -j | jq -r '[.[] | select(.class == "google-chrome" and .workspace.id == 7)] | length')
               if [ "$chrome_on_7" -eq 0 ]; then
                   hyprctl dispatch movetoworkspacesilent "7,address:0x$w_address"
                   exit 0
               fi
           elif [[ "$w_title" == *"Boo"* ]]; then
               chrome_on_12=$(hyprctl clients -j | jq -r '[.[] | select(.class == "google-chrome" and .workspace.id == 12)] | length')
               if [ "$chrome_on_12" -eq 0 ]; then
                   hyprctl dispatch movetoworkspacesilent "12,address:0x$w_address"
                   exit 0
               fi
           fi

           # Automatic check for empty workspaces using window count
           count_1=$(hyprctl workspaces -j | jq 'map(select(.id == 1)) | .[0].windows // 0')
           count_14=$(hyprctl workspaces -j | jq 'map(select(.id == 14)) | .[0].windows // 0')
           
           existing_title_1=$(hyprctl clients -j | jq -r 'map(select(.workspace.id == 1 and .class == "google-chrome")) | .[0].title // ""')
           if [ "$count_1" -eq 0 ] || [[ "$existing_title_1" == "New tab - Google Chrome" ]]; then
               target=1
           elif [ "$count_14" -eq 0 ]; then
               target=14
           else
               # If all are occupied, prompt the user
               choice=$(echo -e "1(main)\n7(PBS)\n12(Boo)\n14(2nd main)" | rofi -dmenu -p "Select Workspace for Chrome:")
               if [[ -n "$choice" ]]; then
                   target=$(echo "$choice" | cut -d '(' -f 1)
               fi
           fi

           if [[ -n "$target" ]]; then
               hyprctl dispatch movetoworkspacesilent "$target,address:0x$w_address"
           fi
       ) &

    elif [[ "$w_class" == "virt-viewer" ]] || ( [[ "$w_class" == ".virt-manager-wrapped" ]] && [[ "$w_title" != "Virtual Machine Manager" ]] ); then
       (
           is_floating=$(hyprctl clients -j | jq -r --arg addr "0x$w_address" '.[] | select(.address == $addr) | .floating')
           echo "DEBUG virt: addr=0x$w_address class=$w_class title=$w_title is_floating=$is_floating" >> "$LOGFILE"
           if [[ "$is_floating" == "true" ]]; then
               echo "DEBUG virt: floating → skipping routing" >> "$LOGFILE"
               exit 0
           fi

           count_28=$(hyprctl workspaces -j | jq 'map(select(.id == 28)) | .[0].windows // 0')
           count_29=$(hyprctl workspaces -j | jq 'map(select(.id == 29)) | .[0].windows // 0')
           count_30=$(hyprctl workspaces -j | jq 'map(select(.id == 30)) | .[0].windows // 0')
           
           if [ "$count_28" -eq 0 ]; then
               target=28
           elif [ "$count_29" -eq 0 ]; then
               target=29
           elif [ "$count_30" -eq 0 ]; then
               target=30
           else
               target=$(echo -e "28\n29\n30" | rofi -dmenu -p "Select Workspace for virt-viewer:")
           fi

           echo "DEBUG virt: routing to target=$target" >> "$LOGFILE"
           if [[ -n "$target" ]]; then
               hyprctl dispatch movetoworkspacesilent "$target,address:0x$w_address"
               hyprctl dispatch workspace "$target"
           fi
       ) &
    fi
  fi
}

nc -U "$SOCKET" < /dev/null | while read -r line; do handle "$line"; done
