#!/usr/bin/env bash

# Find the socket path correctly whether using /tmp/hypr or $XDG_RUNTIME_DIR/hypr
if [ -S "$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" ]; then
    SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
else
    SOCKET="/tmp/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
fi

handle() {
  if [[ "$1" == openwindow\>\>* ]]; then
    # Payload format: address,workspace,class,title
    local payload="${1#openwindow>>}"
    
    # title can contain commas, so read only up to class
    IFS=',' read -r w_address w_workspace w_class w_title <<< "$payload"
    
    if [[ "$w_class" == "brave-browser" ]]; then
       # Run prompt async so we don't block IPC reading
       (
           choice=$(echo -e "15\n27" | rofi -dmenu -p "Select Workspace for Brave:")
           if [[ -n "$choice" ]]; then
               hyprctl dispatch movetoworkspacesilent "$choice,address:0x$w_address"
           fi
       ) &
    elif [[ "$w_class" == "vlc" ]]; then
       (
           choice=$(echo -e "25\n26" | rofi -dmenu -p "Select Workspace for VLC:")
           if [[ -n "$choice" ]]; then
               hyprctl dispatch movetoworkspacesilent "$choice,address:0x$w_address"
           fi
       ) &
    fi
  fi
}

nc -U "$SOCKET" | while read -r line; do handle "$line"; done
