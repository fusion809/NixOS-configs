#!/usr/bin/env zsh
# Get GPU utilization
util=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits)

# Determine class based on usage
if (( util >= 90 )); then
    class="critical"
elif (( util >= 75 )); then
    class="high"
elif (( util >= 50 )); then
    class="medium"
elif (( util >= 25 )); then
    class="low"
else
    class="idle"
fi

# Output JSON
printf '{"text":"%d%%","class":"%s"}' $util "$class"