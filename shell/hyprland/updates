#!/run/current-system/sw/bin/zsh
# Fix PATH to ensure core utilities are available
# Export PATH *after* sourcing .zshrc to ensure it takes precedence
export PATH=/run/wrappers/bin:/run/current-system/sw/bin:/nix/var/nix/profiles/default/bin:$PATH
rehash


# Verify critical binaries are available
if ! command -v nix-store &> /dev/null; then
    echo "Error: nix-store not found in PATH" >&2
    echo "PATH=$PATH" >&2
    exit 1
fi
if ! command -v sudo &> /dev/null; then
    echo "Error: sudo not found in PATH" >&2
    exit 1
fi

cache_file="$HOME/.cache/update"
log_timestamp=$(latestUpdatesRun)
if [[ -n "$log_timestamp" ]]; then
    current_sec=$(date +%s)
        
    if [[ -n "$log_timestamp" ]] && (( current_sec - log_timestamp < 1200 )); then
        # Less than 20 minutes (1200 seconds) have passed
        sed -n '2p' "$cache_file"
        exit 0
    fi
fi

source $HOME/.zshrc

current_date=$(date +"%s")
# Setup logging
log_file="$HOME/.cache/updates.$current_date"
exec 3>&1        # Save original stdout to FD 3
exec > "$log_file" 2>&1 # Redirect stdout and stderr to log file

# Define absolute paths for robustness
NIX_STORE="nix-store"
SUDO="sudo"

echo "PATH=$PATH"


# Set up git SSH authentication
export GIT_SSH_COMMAND="ssh -i ~/.ssh/id_rsa -o IdentitiesOnly=yes"

# Capture files with uncommitted changes before script makes any modifications
files_before=$(git -C $NIXCFG diff --name-only | sort)

if [[ $(git -C $NIXCFG diff | wc -l) -eq 0 ]]; then
	export git_clean=true
else
	export git_clean=false
fi
nixfu

diffLen=$(git -C "$NIXCFG" diff nix/flake.lock | wc -l)
echo "diffLen=$diffLen"
echo "git_clean=$git_clean"
pushStr=""
if $git_clean && [[ $diffLen -gt 0 ]]; then
	pushStr+="updates: Updating flake.lock"
fi
echo "pushStr @L41=$pushStr"
# Get the list of changed nodes
changed_nodes=$(jq -n -r --slurpfile old <(git -C "$NIXCFG" show HEAD:nix/flake.lock) --slurpfile new "$NIXCFG/nix/flake.lock" '
	($old[0].nodes | keys) as $k1 | ($new[0].nodes | keys) as $k2 |
	($k1 - $k2) + ($k2 - $k1) +
	([$k1[] | select($old[0].nodes[.] != $new[0].nodes[.])]) | unique | join(" ")
')
outputStr=""
# Function to retry commands on failure
retry() {
	local max_attempts=10
	local wait_time=10
	local attempt=1

	while true; do
		if "$@"; then
			return 0
		else
			if [[ $attempt -ge $max_attempts ]]; then
				echo "Command '$*' failed after $max_attempts attempts." >&2
				return 1
			fi
			echo "Command '$*' failed. Retrying in ${wait_time}s... (Attempt $attempt/$max_attempts)" >&2
			sleep $wait_time
			attempt=$((attempt + 1))
		fi
	done
}
# Function to add symbol to outputStr only if not already present
add_symbol() {
	local symbol=$1
	if [[ "$outputStr" != *"$symbol"* ]]; then
		outputStr+="$symbol"
	fi
}
# Function to check for package changes
check_packages() {
	local s_rev=$1
	local u_rev=$2
	local m_rev=$3
	local vim_rev=$4
	local s_path=$5
	local u_path=$6
	local m_path=$7
	local vim_path=$8
	retry nix eval --impure --raw --expr "import $NIXCFG/nix/compare.nix { mode = \"packages\"; stableRev = \"$s_rev\"; unstableRev = \"$u_rev\"; masterRev = \"$m_rev\"; vimRev = \"$vim_rev\"; stablePath = \"$s_path\"; unstablePath = \"$u_path\"; masterPath = \"$m_path\"; vimPath = \"$vim_path\"; username = \"$USER\"; }"
}

# Get current revisions and store paths
# Use nix flake archive to get store paths for inputs (avoids re-downloading)
archive_json=$(nix flake archive $NIXCFG/nix --json)

curr_s=$(echo "$archive_json" | jq -r '.inputs.nixpkgs.locked.rev')
curr_u=$(echo "$archive_json" | jq -r '.inputs."nixpkgs-unstable".locked.rev')
curr_m=$(echo "$archive_json" | jq -r '.inputs."nixpkgs-master".locked.rev')
curr_vim=$(echo "$archive_json" | jq -r '.inputs."vim-src".locked.rev')
curr_hm=$(echo "$archive_json" | jq -r '.inputs."home-manager".locked.rev')

path_s=$(echo "$archive_json" | jq -r '.inputs.nixpkgs.path')
path_u=$(echo "$archive_json" | jq -r '.inputs."nixpkgs-unstable".path')
path_m=$(echo "$archive_json" | jq -r '.inputs."nixpkgs-master".path')
path_vim=$(echo "$archive_json" | jq -r '.inputs."vim-src".path')
path_hm=$(echo "$archive_json" | jq -r '.inputs."home-manager".path')


if [[ " ${changed_nodes} " == *" home-manager "* ]]; then
	old_hm=$(jq -r '.nodes."home-manager".locked.rev' <(git -C $NIXCFG show HEAD:nix/flake.lock))
	
	# Compare home-manager modules directory paths
	old_out=$(retry nix eval --impure --raw --expr "import $NIXCFG/nix/compare.nix { mode = \"home\"; hmRev = \"$old_hm\"; }")
	new_out=$(retry nix eval --impure --raw --expr "import $NIXCFG/nix/compare.nix { mode = \"home\"; hmRev = \"$curr_hm\"; hmPath = \"$path_hm\"; }")
	echo "home-manager: $old_out"
	echo "home-manager: $new_out"

	if [[ "$old_out" != "$new_out" ]]; then
		add_symbol "h"
	fi
fi

if [[ " ${changed_nodes} " == *" nixpkgs-master "* ]]; then
	old_rev=$(jq -r '.nodes."nixpkgs-master".locked.rev' <(git -C $NIXCFG show HEAD:nix/flake.lock))
	
	# Automatically extract master package names from packages.nix
	master_pkgs=$(grep -o 'master\.[a-zA-Z0-9_-]*' $NIXCFG/nix/packages.nix | sed 's/master\.//' | sort -u | tr '\n' ' ')
	
	# Compare master packages
	old_out=$(retry nix eval --impure --raw --expr "import $NIXCFG/nix/compare.nix { mode = \"master\"; masterRev = \"$old_rev\"; packageNames = \"$master_pkgs\"; }")
	new_out=$(retry nix eval --impure --raw --expr "import $NIXCFG/nix/compare.nix { mode = \"master\"; masterRev = \"$curr_m\"; packageNames = \"$master_pkgs\"; masterPath = \"$path_m\"; }")

	if [[ "$old_out" != "$new_out" ]]; then
		add_symbol "m"
	fi
	echo "master: $old_out"
	echo "master: $new_out"
fi
if [[ " ${changed_nodes} " == *" nixpkgs "* ]]; then
	old_rev=$(jq -r '.nodes.nixpkgs.locked.rev' <(git -C $NIXCFG show HEAD:nix/flake.lock))
	
	# Check if packages changed (keeping unstable/master constant)
	# For old check, we use old stable rev (fetched), but keep current unstable/master/vim paths (local)
	old_out=$(check_packages "$old_rev" "$curr_u" "$curr_m" "$curr_vim" "" "$path_u" "$path_m" "$path_vim")
	new_out=$(check_packages "$curr_s" "$curr_u" "$curr_m" "$curr_vim" "$path_s" "$path_u" "$path_m" "$path_vim")
	echo "stable: $old_out"
	echo "stable: $new_out"
	if [[ "$old_out" != "$new_out" ]]; then
		add_symbol "s"
	fi
fi
if [[ " $changed_nodes " == *" nixpkgs-unstable "* ]]; then
	old_rev=$(jq -r '.nodes."nixpkgs-unstable".locked.rev' <(git -C $NIXCFG show HEAD:nix/flake.lock))
	
	# Check if packages changed (keeping stable/master constant)
	old_out=$(check_packages "$curr_s" "$old_rev" "$curr_m" "$curr_vim" "$path_s" "" "$path_m" "$path_vim")
	new_out=$(check_packages "$curr_s" "$curr_u" "$curr_m" "$curr_vim" "$path_s" "$path_u" "$path_m" "$path_vim")
	echo "unstable: $old_out"
	echo "unstable: $new_out"
	if [[ "$old_out" != "$new_out" ]]; then
		add_symbol "u"
	fi
fi

if ( [[ -n $HY3_TAG ]] && [[ $HY3_TAG != "null" ]] && [[ $HY3_TAG != $HY3_INST ]] && [[ -n $HY3_INST ]] ); then
	add_symbol "󱇛"
	sed -i \
        -e "s|https://github.com/outfoxxed/hy3?ref=refs/tags/$HY3_INST|https://github.com/outfoxxed/hy3?ref=refs/tags/$HY3_TAG|" "$FLAKE_FILE"
	if [[ ${#pushStr} -gt 0 ]]; then
		pushStr+="; "
	fi
	pushStr+="hy3: $HY3_INST->$HY3_TAG"
fi

if ( [[ $HYPR_INST != $HYPR_TAG ]] && [[ $HYPR_TAG != "null" ]] && [[ -n $HYPR_TAG ]] ); then
	add_symbol ""
	sed -i -e "s|https://github.com/hyprwm/Hyprland?submodules=1&ref=refs/tags/$HYPR_INST|https://github.com/hyprwm/Hyprland?submodules=1&ref=refs/tags/$HYPR_TAG|" "$FLAKE_FILE"
	if [[ ${#pushStr} -gt 0 ]]; then
		pushStr+="; "
	fi
	pushStr+="hyprland: $HYPR_INST->$HYPR_TAG"
fi

if ( [[ $vim_instver != $vim_upver ]] && [[ -n $vim_upver ]] && [[ -f /run/current-system/sw/bin/vim ]] ); then
	add_symbol ""
fi

retry git -C $GHUBO/OpenRA pull origin bleed -q
latestRev=$(git -C $GHUBO/OpenRA log | head -n 1 | cut -d ' ' -f 2)
upno=$(git -C $GHUBO/OpenRA rev-list --count HEAD)
uphash=$(echo $latestRev | head -c 7)
packagedVer=$(ls -ld $(which openra-ra) | cut -d '/' -f 9 | cut -d '-' -f 4)
latestVer="$upno.git.$uphash"
if [[ $latestVer != $packagedVer ]]; then
	add_symbol "󱢇"
	
	if [[ ${#pushStr} -gt 0 ]]; then
		pushStr+="; "
	fi
	pushStr+="openra: $packagedVer->$latestVer"
	
	# Prefetch the new hash
	# We use the local repo path to be consistent with the fetchGit in default.nix, but prefetch needs the hash of the *content* at that revision.
	# Using the file URL ensures we get the hash of the tree.
	new_hash=$(nix-prefetch-git --url "file://$GHUBO/OpenRA" --rev "$latestRev" --quiet | jq -r '.hash')
	
	if [[ -n "$new_hash" ]]; then
		sed -i "s|hash = \".*\"|hash = \"$new_hash\"|" "$NIXCFG/nixpkgs/openra/engines/git/default.nix"
	else
		echo "Warning: Failed to prefetch OpenRA hash" >&2
	fi
fi
if [[ -f "$NIXCFG/nixpkgs/marvin/package.nix" ]]; then
	marvin_pkg_file="$NIXCFG/nixpkgs/marvin/package.nix"
	current_marvin_ver=$(grep -o 'version = ".*"' "$marvin_pkg_file" | cut -d '"' -f 2)
	latest_marvin_ver=$(retry curl -L -s "https://docs.chemaxon.com/display/docs/Marvin+Desktop+Suite+History+of+Changes" | grep -E -o 'Marvin (Desktop Suite )?[0-9]+\.[0-9]+\.[0-9]+' | sed -E 's/Marvin (Desktop Suite )?//' | sort -V | tail -n 1)
	
	if [[ -n "$latest_marvin_ver" ]] && [[ "$latest_marvin_ver" != "$current_marvin_ver" ]]; then
		new_url="http://dl.chemaxon.com/marvin/${latest_marvin_ver}/marvin_linux_${latest_marvin_ver}.deb"
		if retry curl --output /dev/null --silent --head --fail "$new_url"; then
			new_sri_hash=$(retry nix-prefetch-url --type sha256 --sri "$new_url")
			if [[ -n "$new_sri_hash" ]]; then
				add_symbol "󰄻"
				# NixOS
				sed -i "s/version = \".*\"/version = \"$latest_marvin_ver\"/" "$marvin_pkg_file"
				sed -i "s|hash = \".*\"|hash = \"$new_sri_hash\"|" "$marvin_pkg_file"
				# Arch
				sed -i "s/^pkgver=.*/pkgver=$latest_marvin_ver/" /arch$HOME/AUR/marvin/PKGBUILD
				wget -cq http://dl.chemaxon.com/marvin/${latest_marvin_ver}/marvin_linux_${latest_marvin_ver}.rpm -O /arch$HOME/AUR/marvin/marvin_linux-${latest_marvin_ver}.rpm
				aur_hash=$(md5sums /arch$HOME/AUR/marvin/marvin_linux-${latest_marvin_ver}.rpm)
				sed -i "14s/'.*'/'$aur_hash'/" /arch$HOME/AUR/marvin/PKGBUILD
				if [[ ${#pushStr} -gt 0 ]]; then
					pushStr+="; "
				fi
				pushStr+="marvin: $current_marvin_ver->$latest_marvin_ver"
			fi
		fi
	fi
fi

if [[ $(cat $cache_file | grep -v "[0-9][0-9]/[0-9][0-9]/[0-9][0-9]" | tail -n 1 | wc -l) -eq 1 ]]; then
	# Add cached symbols one by one to avoid duplicates
	cached_symbols=$(cat $cache_file | grep -v "[0-9][0-9]/[0-9][0-9]/[0-9][0-9]" | tail -n 1)
	for (( i=0; i<${#cached_symbols}; i++ )); do
		add_symbol "${cached_symbols:$i:1}"
	done
fi
echo $outputStr >&3
echo $(date +"%r %a %d %b %y") > $cache_file
echo $outputStr >> $cache_file
echo $pushStr > $HOME/.cache/pushStr
# Protect flake inputs from GC
mkdir -p "$HOME/.cache/nix-gcroots"
# We parse the archive_json which contains the paths of the JUST UPDATED inputs
echo "$archive_json" | jq -r '.inputs | .[] | .path' | while read -r store_path; do
	if [[ -n "$store_path" && -e "$store_path" ]]; then
		nix-store --add-root "$HOME/.cache/nix-gcroots/${store_path:t}" --indirect -r "$store_path" >/dev/null
	fi
done

nixcg

if [[ ${#pushStr} -gt 0 ]]; then
	# Get current list of modified files
	files_after=$(git -C $NIXCFG diff --name-only | sort)
	
	# Files that were already modified before the script ran
	# These are OK because they're not the script's responsibility
	files_already_modified="$files_before"
	
	# Check each modified file
	safe_to_push=true
	
	for file in $(echo "$files_after"); do
		# flake.lock is always OK for the script to modify
		if [[ "$file" == "nix/flake.lock" ]]; then
			continue
		fi

		# marvin package.nix is OK
		if [[ "$file" == "nixpkgs/marvin/package.nix" ]]; then
			continue
		fi

		# Skip files that were already modified before the script ran
		if echo "$files_already_modified" | grep -q "^${file}$"; then
			echo "Skipping push: file '$file' was already modified before script ran"
			safe_to_push=false
			break
		fi
		
		# For flake.nix, check if changes are ONLY the hy3/hyprland URL updates
		if [[ "$file" == "nix/flake.nix" ]]; then
			# Get the diff for flake.nix
			diff_output=$(git -C $NIXCFG diff nix/flake.nix)
			
			# Extract only the changed lines (lines starting with + or -)
			# Exclude the +++ and --- header lines
			changed_lines=$(echo "$diff_output" | grep -E '^[+-]' | grep -v -E '^(---|\+\+\+)')
			
			# Check if all changes match the expected patterns
			# Expected patterns: lines with hy3 or Hyprland URLs with version tags
			while IFS= read -r line; do
				# Skip empty lines
				[[ -z "$line" ]] && continue
				
				# Check if line is a hy3 or Hyprland URL change
				if echo "$line" | grep -qE '(github.com/outfoxxed/hy3\?ref=refs/tags/|github.com/hyprwm/Hyprland\?submodules=1&ref=refs/tags/)'; then
					continue
				else
					echo "Skipping push: flake.nix has unexpected changes:"

					echo "$line"
					safe_to_push=false
					break
				fi
			done <<< "$changed_lines"
			
			[[ "$safe_to_push" == "false" ]] && break
		else
			# Any other file is unexpected
			echo "Skipping push: unexpected file modified: $file"
			safe_to_push=false
			break
		fi
	done
	
	echo "safe_to_push=$safe_to_push"

	if [[ "$safe_to_push" == "true" ]]; then
		# Only script-made changes exist, safe to push
		git -C $NIXCFG add --all
		git -C $NIXCFG commit -m "$pushStr"
		git -C $NIXCFG push origin $(git -C $NIXCFG rev-parse --abbrev-ref HEAD)
	fi
fi
