if [[ $(cat $cache_file | grep -v "[0-9][0-9]/[0-9][0-9]/[0-9][0-9]" | tail -n 1 | wc -l) -eq 1 ]]; then
	# Add cached symbols one by one to avoid duplicates
	cached_symbols=$(cat $cache_file | grep -v "[0-9][0-9]/[0-9][0-9]/[0-9][0-9]" | tail -n 1)
	echo "$cached_symbols" | grep -o -E '[hmuso][0-9]*|.' | while read -r token; do
		add_symbol "$token"
	done
fi
echo $outputStr >&3
echo $pushStr > $HOME/.cache/pushStr
nixcg_log="$HOME/.cache/nixcg.$current_date"
# Use manual GC command to avoid clearing the roots we just created (nixcg function does rm -rf)
{
	nixcg
} > "$nixcg_log" 2>&1

if [[ ${#pushStr} -gt 0 ]]; then
	# We only want to commit files we explicitly checked or managed
	files_to_commit=()

	if git -C $NIXCFG diff --name-only | grep -q "^nix/flake.lock$"; then
		files_to_commit+=("nix/flake.lock")
	fi

	if git -C $NIXCFG diff --name-only | grep -q "^nixpkgs/marvin/package.nix$"; then
		files_to_commit+=("nixpkgs/marvin/package.nix")
	fi

	if git -C $NIXCFG diff --name-only | grep -q "^nixpkgs/openra/engines/git/default.nix$"; then
		files_to_commit+=("nixpkgs/openra/engines/git/default.nix")
	fi

	if [[ ${#files_to_commit[@]} -gt 0 ]]; then
		git -C $NIXCFG add "${files_to_commit[@]}"
		git -C $NIXCFG commit -m "$pushStr"
		git -C $NIXCFG push origin $(git -C $NIXCFG rev-parse --abbrev-ref HEAD)
	else
		echo "No script-managed changes detected to push."
	fi
fi

end_date=$(date +"%r %a %d %b %y")
echo "Run ended: $end_date" >> $log_file
echo "$end_date" > $cache_file
echo $outputStr >> $cache_file