#!/usr/bin/env zsh
current_date=$(date +"%s")
if [[ -f $HOME/.cache/last_update ]]; then
	touch $HOME/.cache/last_update
fi
latest_update=$(cat $HOME/.cache/last_update)
if [[ $current_date -ge $(($latest_update + 3600)) ]]; then
	source "${0:a:h}/../user/main.sh" &> /tmp/main.log
	nixfu &> /tmp/flake-update.log
	diffLen=$(git -C $NIXCFG diff nix/flake.lock | wc -l)
	outputStr=""
	if [[ "$diffLen" -gt 0 ]]; then
		outputStr+="󱄅"
	fi

	if ( [[ -n $HY3_TAG ]] && [[ $HY3_TAG != $HY3_INST ]] && [[ -n $HY3_INST ]] ); then
		outputStr+=" 󱇛"
		sed -i -e "s|nixfrb|hyprupdate|g" $NIXCFG/shell/hyprland/update_func
	fi

	if ( [[ $HYPR_INST != $HYPR_TAG ]] && [[ -n $HYPR_TAG ]] ); then
		outputStr+=" "
		sed -i -e "s|nixfrb|hyprupdate|g" $NIXCFG/shell/hyprland/update_func
	fi
	if ( [[ $vim_instver != $vim_upver ]] && [[ -n $vim_upver ]]); then
		outputStr+=" "
	fi

	git -C $GHUBO/OpenRA pull origin bleed -q
	latestRev=$(revision $GHUBO/OpenRA)
	packagedRev=$(cat $NIXCFG/nixpkgs/openra/engines/git/default.nix | grep 'rev' | cut -d '"' -f 2)
	if [[ $latestRev != $packagedRev ]]; then
	outputStr+=" 󱢇"
	sed -i -e "s|nixfrb|openraup|g" $NIXCFG/shell/hyprland/update_func
	fi

	echo "$outputStr" > $HOME/.cache/updates
fi
cat $HOME/.cache/updates