#!/run/current-system/sw/bin/zsh
current_date=$(date +"%s")
cache_file="$HOME/.cache/update"
source "${0:a:h}/../user/13-update.sh"
current_min=$(date +"%M")
current_hour=$(date +"%H")

if (( current_min < 20 )); then
    slot_min="00"
elif (( current_min < 40 )); then
    slot_min="20"
else
    slot_min="40"
fi

# Calculate epoch timestamp for the start of the current 20-minute slot
slot_start_ts=$(date -d "$current_hour:$slot_min:00" +"%s")

# Check if we already ran in this slot by looking at the latest log file
latest_log=$(ls "$HOME/.cache/updates."* 2>/dev/null | tail -n 1)
if [[ -n "$latest_log" ]]; then
    # Extract timestamp from filename (format: updates.TIMESTAMP)
    log_timestamp="${latest_log##*.}"
    
    # If the last log file was created during or after the current slot started,
    # we already ran in this slot
    if [[ -n "$log_timestamp" ]] && (( log_timestamp >= slot_start_ts )); then
        if [[ -f "$cache_file" ]]; then
            if [[ $(cat "$cache_file" | wc -l) -lt 2 ]]; then
                 echo "" >> "$cache_file"
            fi
            sed -n '2p' "$cache_file"
        fi
        exit 0
    fi
fi
source $HOME/.zshrc
# Setup logging
log_file="$HOME/.cache/updates.$current_date"
exec 3>&1        # Save original stdout to FD 3
exec > "$log_file" 2>&1 # Redirect stdout and stderr to log file
echo "PATH=$PATH"

# Capture files with uncommitted changes before script makes any modifications
files_before=$(git -C $NIXCFG diff --name-only | sort)
# Cache the HEAD flake.lock before nixfu may update it - used for all old_rev comparisons
head_flake_lock=$(git -C $NIXCFG show HEAD:nix/flake.lock)

if [[ $(git -C $NIXCFG diff | wc -l) -eq 0 ]]; then
	export git_clean=true
else
	export git_clean=false
fi
nixfu

diffLen=$(git -C "$NIXCFG" diff nix/flake.lock | wc -l)
echo "diffLen=$diffLen"
echo "git_clean=$git_clean"
pushStr=""
if $git_clean && [[ $diffLen -gt 0 ]]; then
	pushStr+="updates: Updating flake.lock"
fi
echo "pushStr @L83=$pushStr"
# Get the list of changed nodes
changed_nodes=$(jq -n -r --argjson old "$head_flake_lock" --slurpfile new "$NIXCFG/nix/flake.lock" '
	($old.nodes | keys) as $k1 | ($new[0].nodes | keys) as $k2 |
	($k1 - $k2) + ($k2 - $k1) +
	([$k1[] | select($old.nodes[.] != $new[0].nodes[.])]) | unique | join(" ")
')
echo "changed_nodes=$changed_nodes"
outputStr=""
# Function to retry commands on failure
retry() {
	local max_attempts=10
	local wait_time=10
	local attempt=1

	while true; do
		if "$@"; then
			return 0
		else
			if [[ $attempt -ge $max_attempts ]]; then
				echo "Command '$*' failed after $max_attempts attempts." >&2
				return 1
			fi
			echo "Command '$*' failed. Retrying in ${wait_time}s... (Attempt $attempt/$max_attempts)" >&2
			sleep $wait_time
			attempt=$((attempt + 1))
		fi
	done
}
# Function to add symbol to outputStr only if not already present
add_symbol() {
	local symbol=$1
	if [[ "$outputStr" != *"$symbol"* ]]; then
		outputStr+="$symbol"
	fi
}
# Function to check for package changes
check_packages() {
	local s_rev=$1
	local u_rev=$2
	local m_rev=$3
	local os_rev=$4
	local vim_rev=$5
	local s_path=$6
	local u_path=$7
	local m_path=$8
	local os_path=$9
	local vim_path=${10}
	retry nix eval --impure --raw --expr "import $NIXCFG/nix/compare.nix { mode = \"packages\"; stableRev = \"$s_rev\"; unstableRev = \"$u_rev\"; masterRev = \"$m_rev\"; oldstableRev = \"$os_rev\"; vimRev = \"$vim_rev\"; stablePath = \"$s_path\"; unstablePath = \"$u_path\"; masterPath = \"$m_path\"; oldstablePath = \"$os_path\"; vimPath = \"$vim_path\"; username = \"$USER\"; }"
}

# Get current revisions and store paths
# Use nix flake archive to get store paths for inputs (avoids re-downloading)
archive_json=$(nix flake archive $NIXCFG/nix --json)
# Note: nix flake archive --json does NOT include locked.rev; get revisions from flake.lock directly
flake_lock="$NIXCFG/nix/flake.lock"

curr_s=$(jq -r '.nodes.nixpkgs.locked.rev' "$flake_lock")
curr_u=$(jq -r '.nodes."nixpkgs-unstable".locked.rev' "$flake_lock")
curr_m=$(jq -r '.nodes."nixpkgs-master".locked.rev' "$flake_lock")
curr_os=$(jq -r '.nodes."nixpkgs-oldstable".locked.rev' "$flake_lock")
curr_vim=$(jq -r '.nodes."vim-src".locked.rev' "$flake_lock")
curr_hm=$(jq -r '.nodes."home-manager".locked.rev' "$flake_lock")

path_s=$(echo "$archive_json" | jq -r '.inputs.nixpkgs.path')
path_u=$(echo "$archive_json" | jq -r '.inputs."nixpkgs-unstable".path')
path_m=$(echo "$archive_json" | jq -r '.inputs."nixpkgs-master".path')
path_os=$(echo "$archive_json" | jq -r '.inputs."nixpkgs-oldstable".path')
path_vim=$(echo "$archive_json" | jq -r '.inputs."vim-src".path')
path_hm=$(echo "$archive_json" | jq -r '.inputs."home-manager".path')

echo "curr_s=$curr_s curr_u=$curr_u curr_m=$curr_m curr_os=$curr_os curr_vim=$curr_vim curr_hm=$curr_hm"


if [[ " ${changed_nodes} " == *" home-manager "* ]]; then
	old_hm=$(echo "$head_flake_lock" | jq -r '.nodes."home-manager".locked.rev')
	
	# Compare home-manager modules directory paths
	old_out=$(retry nix eval --impure --raw --expr "import $NIXCFG/nix/compare.nix { mode = \"home\"; hmRev = \"$old_hm\"; }")
	new_out=$(retry nix eval --impure --raw --expr "import $NIXCFG/nix/compare.nix { mode = \"home\"; hmRev = \"$curr_hm\"; hmPath = \"$path_hm\"; }")
	# Treat paths as single-item arrays to match diff style
	diff_out=$(jq -n --arg old "$old_out" --arg new "$new_out" 'if $old == $new then [] else [$new] end')
	if [[ "$diff_out" != "[]" ]] && [[ -n "$diff_out" ]]; then
		echo "home-manager changes: $diff_out"
		count=$(echo "$diff_out" | jq 'length' 2>/dev/null)
		if [[ -n "$count" ]]; then
			add_symbol "h$count"
		fi
	fi
fi

if [[ " ${changed_nodes} " == *" nixpkgs-master "* ]]; then
	old_rev=$(echo "$head_flake_lock" | jq -r '.nodes."nixpkgs-master".locked.rev')
	
	# Check if packages changed (keeping stable/unstable/oldstable constant)
	old_out=$(check_packages "$curr_s" "$curr_u" "$old_rev" "$curr_os" "$curr_vim" "$path_s" "$path_u" "" "$path_os" "$path_vim")
	new_out=$(check_packages "$curr_s" "$curr_u" "$curr_m" "$curr_os" "$curr_vim" "$path_s" "$path_u" "$path_m" "$path_os" "$path_vim")

	# Log only the differences
	diff_out=$(jq -n --argjson old "$old_out" --argjson new "$new_out" '($new - $old)')
	if [[ "$diff_out" != "[]" ]] && [[ -n "$diff_out" ]]; then
		echo "master changes: $diff_out"
		count=$(echo "$diff_out" | jq 'length' 2>/dev/null)
		if [[ -n "$count" ]]; then
			add_symbol "m$count"
		fi
	fi
fi
if [[ " ${changed_nodes} " == *" nixpkgs "* ]]; then
	old_rev=$(echo "$head_flake_lock" | jq -r '.nodes.nixpkgs.locked.rev')
	
	# Check if packages changed (keeping unstable/master/oldstable constant)
	# For old check, we use old stable rev (fetched), but keep current unstable/master/oldstable/vim paths (local)
	old_out=$(check_packages "$old_rev" "$curr_u" "$curr_m" "$curr_os" "$curr_vim" "" "$path_u" "$path_m" "$path_os" "$path_vim")
	new_out=$(check_packages "$curr_s" "$curr_u" "$curr_m" "$curr_os" "$curr_vim" "$path_s" "$path_u" "$path_m" "$path_os" "$path_vim")
	# Log only the differences
	diff_out=$(jq -n --argjson old "$old_out" --argjson new "$new_out" '($new - $old)')
	if [[ "$diff_out" != "[]" ]] && [[ -n "$diff_out" ]]; then
		echo "stable changes: $diff_out"
		count=$(echo "$diff_out" | jq 'length' 2>/dev/null)
		if [[ -n "$count" ]]; then
			add_symbol "s$count"
		fi
	fi
fi
if [[ " ${changed_nodes} " == *" nixpkgs-oldstable "* ]]; then
	old_rev=$(echo "$head_flake_lock" | jq -r '.nodes."nixpkgs-oldstable".locked.rev')
	
	# Check if packages changed (keeping stable/unstable/master constant)
	old_out=$(check_packages "$curr_s" "$curr_u" "$curr_m" "$old_rev" "$curr_vim" "$path_s" "$path_u" "$path_m" "" "$path_vim")
	new_out=$(check_packages "$curr_s" "$curr_u" "$curr_m" "$curr_os" "$curr_vim" "$path_s" "$path_u" "$path_m" "$path_os" "$path_vim")
	# Log only the differences
	diff_out=$(jq -n --argjson old "$old_out" --argjson new "$new_out" '($new - $old)')
	if [[ "$diff_out" != "[]" ]] && [[ -n "$diff_out" ]]; then
		echo "oldstable changes: $diff_out"
		count=$(echo "$diff_out" | jq 'length' 2>/dev/null)
		if [[ -n "$count" ]]; then
			add_symbol "o$count"
		fi
	fi
fi
if [[ " $changed_nodes " == *" nixpkgs-unstable "* ]]; then
	old_rev=$(echo "$head_flake_lock" | jq -r '.nodes."nixpkgs-unstable".locked.rev')
	
	# Check if packages changed (keeping stable/master/oldstable constant)
	old_out=$(check_packages "$curr_s" "$old_rev" "$curr_m" "$curr_os" "$curr_vim" "$path_s" "" "$path_m" "$path_os" "$path_vim")
	new_out=$(check_packages "$curr_s" "$curr_u" "$curr_m" "$curr_os" "$curr_vim" "$path_s" "$path_u" "$path_m" "$path_os" "$path_vim")
	# Log only the differences
	diff_out=$(jq -n --argjson old "$old_out" --argjson new "$new_out" '($new - $old)')
	if [[ "$diff_out" != "[]" ]] && [[ -n "$diff_out" ]]; then
		echo "unstable changes: $diff_out"
		count=$(echo "$diff_out" | jq 'length' 2>/dev/null)
		if [[ -n "$count" ]]; then
			add_symbol "u$count"
		fi
	fi
fi

if [[ -f "$NIXCFG/nixpkgs/marvin/package.nix" ]]; then
	marvin_pkg_file="$NIXCFG/nixpkgs/marvin/package.nix"
	current_marvin_ver=$(grep -o 'version = ".*"' "$marvin_pkg_file" | cut -d '"' -f 2)
	latest_marvin_ver=$(retry curl -L -s \
  -b ~/Downloads/download.chemaxon.com_cookies.txt \
  https://download.chemaxon.com/marvin-sketch | grep -Eo 'marvin_linux_[0-9]+\.[0-9]+\.[0-9].deb' | sort -V | tail -n 1 | cut -d "_" -f 3 | sed 's/.deb//g')
	
	if [[ -n "$latest_marvin_ver" ]] && [[ "$latest_marvin_ver" != "$current_marvin_ver" ]]; then
		new_url="http://dl.chemaxon.com/marvin/${latest_marvin_ver}/marvin_linux_${latest_marvin_ver}.deb"
		if retry curl --output /dev/null --silent --head --fail "$new_url"; then
			new_sri_hash=$(retry nix-prefetch-url --type sha256 "$new_url")
			if [[ -n "$new_sri_hash" ]]; then
				add_symbol "󰄻"
				# NixOS
				sed -i "s/version = \".*\"/version = \"$latest_marvin_ver\"/" "$marvin_pkg_file"
				sed -i "s|hash = \".*\"|hash = \"$new_sri_hash\"|" "$marvin_pkg_file"
				# Arch
				sed -i "s/^pkgver=.*/pkgver=$latest_marvin_ver/" /arch$HOME/AUR/marvin/PKGBUILD
				wget -cq http://dl.chemaxon.com/marvin/${latest_marvin_ver}/marvin_linux_${latest_marvin_ver}.rpm -O /arch$HOME/AUR/marvin/marvin_linux-${latest_marvin_ver}.rpm
				aur_hash=$(md5sums /arch$HOME/AUR/marvin/marvin_linux-${latest_marvin_ver}.rpm)
				sed -i "14s/'.*'/'$aur_hash'/" /arch$HOME/AUR/marvin/PKGBUILD
				if [[ ${#pushStr} -gt 0 ]]; then
					pushStr+="; "
				fi
				pushStr+="marvin: $current_marvin_ver->$latest_marvin_ver"
			fi
		fi
	fi
fi

