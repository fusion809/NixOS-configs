#!/usr/bin/env zsh


LOGFILE="$HOME/.cache/temperature.log"

if [[ ! -f "$LOGFILE" ]]; then
    notify-send "Temperature graph" "No log file found at $LOGFILE"
    exit 1
fi

# Use nix-shell to run gnuplot if it's not in PATH, or just run it if installed.
# We assume user might not have it permanently installed, so nix-shell is safer.

if ! command -v gnuplot &> /dev/null; then
    notify-send "Error" "Gnuplot not found. Please rebuild your system."
    exit 1
fi

# Calculate timezone offset in seconds
offset_str=$(date +%z)
sign="${offset_str:0:1}"
h="${offset_str:1:2}"
m="${offset_str:3:2}"
# Use 10# to force base 10 (avoid octal for 08/09)
offset_sec=$(( 10#$h * 3600 + 10#$m * 60 ))
if [[ "$sign" == "-" ]]; then
    offset_sec=$(( -offset_sec ))
fi

mkdir -p "$HOME/.cache/graphs/temperature"
IMGFILE="$HOME/.cache/graphs/temperature/graph.png"

# Function to generate graph
generate_graph() {
    gnuplot -e "
        set title \"Motherboard temperature history\";
        set xdata time;
        set timefmt \"%s\";
        set format x \"%I:%M %p\\n%d/%m\";
        set xlabel \"Time\";
        set ylabel \"Temperature (°C)\";
        set key off;
        set grid;
        set xtics rotate by -45;
        set bmargin 6;
        set term pngcairo size 1000,700 font \"monospace,16\";
        set output \"${IMGFILE}.tmp\";
        plot \"$LOGFILE\" using (\$1 + $offset_sec):2 with lines lw 3 title \"Temp\";
    "
    mv "${IMGFILE}.tmp" "$IMGFILE"
}

# Initial generation
generate_graph

# Open Gwenview in background
if command -v gwenview &> /dev/null; then
    gwenview "$IMGFILE" &
    GWENVIEW_PID=$!
else
    notify-send "Error" "gwenview not found."
    exit 1
fi

# Loop to update graph while Gwenview is running
while kill -0 "$GWENVIEW_PID" 2> /dev/null; do
    sleep 5
    generate_graph
done
