#!/usr/bin/env zsh

MODE="${1:-cpu}"
LOGFILE="$HOME/.cache/system_graph.log"

# Configure paths and plot based on mode
if [[ "$MODE" == "cpu" ]]; then
    mkdir -p "$HOME/.cache/graphs/system/cpu"
    IMGFILE="$HOME/.cache/graphs/system/cpu/graph.png"
    PLOT_TITLE="CPU usage"
    # Filter valid timestamps > 2020 (1.6e9)
    DATA_SRC="< awk '\$1 > 1600000000' $LOGFILE"
    # Plot column 2 (CPU Usage)
    PLOT_CMD="plot \"$DATA_SRC\" using (\$1 + offset_sec):2 title \"CPU usage (%)\" with lines lw 3 lc rgb \"green\""
    YLABEL="Usage (%)"
elif [[ "$MODE" == "memory" ]]; then
    mkdir -p "$HOME/.cache/graphs/system/memory"
    IMGFILE="$HOME/.cache/graphs/system/memory/graph.png"
    PLOT_TITLE="Memory usage"
    DATA_SRC="< awk '\$1 > 1600000000' $LOGFILE"
    # Plot column 3 (Memory Usage)
    PLOT_CMD="plot \"$DATA_SRC\" using (\$1 + offset_sec):3 title \"Memory usage (%)\" with lines lw 3 lc rgb \"blue\""
    YLABEL="Usage (%)"
else
    # Default to CPU
    mkdir -p "$HOME/.cache/graphs/system/cpu"
    IMGFILE="$HOME/.cache/graphs/system/cpu/graph.png"
    PLOT_TITLE="CPU usage"
    DATA_SRC="< awk '\$1 > 1600000000' $LOGFILE"
    PLOT_CMD="plot \"$DATA_SRC\" using (\$1 + offset_sec):2 title \"CPU usage (%)\" with lines lw 3 lc rgb \"green\""
    YLABEL="Usage (%)"
fi

# Timezone offset
offset_str=$(date +%z)
sign="${offset_str:0:1}"
h="${offset_str:1:2}"
m="${offset_str:3:2}"
offset_sec=$(( 10#$h * 3600 + 10#$m * 60 ))
if [[ "$sign" == "-" ]]; then offset_sec=$(( -offset_sec )); fi

# Graphing Function
generate_graph() {
    if [[ ! -s "$LOGFILE" ]]; then return 1; fi
    
    # Calculate optimal xtics step
    local start_ts=$(awk '$1 > 1600000000 {print $1; exit}' "$LOGFILE")
    local last_ts=$(awk 'END {print $1}' "$LOGFILE")
    
    if [[ -z "$start_ts" || -z "$last_ts" ]]; then return 1; fi
    
    local duration=$(( last_ts - start_ts ))
    local step=$(( duration / 10 ))
    if (( step < 60 )); then step=60; fi
    
    local format_str="%I:%M %p"
    if (( duration > 86400 )); then
        format_str="%d/%m\\n%I:%M %p"
    fi
    
    gnuplot -e "
        offset_sec = $offset_sec;
        set title \"$PLOT_TITLE\";
        set xdata time;
        set timefmt \"%s\";
        set format x \"$format_str\";
        set xtics rotate by -45 $step;
        set xlabel \"Time\";
        set ylabel \"$YLABEL\";
        set yrange [0:100];
        set key outside;
        set grid;
        set term pngcairo size 1000,700 font \"monospace,16\";
        set output \"${IMGFILE}.tmp\";
        $PLOT_CMD;
    "
    mv "${IMGFILE}.tmp" "$IMGFILE"
}

# Wait for log file
while [[ ! -f "$LOGFILE" ]]; do
    sleep 1
done

# Initial generation
generate_graph

# Open gwenview
if command -v gwenview &> /dev/null; then
    if [[ -f "$IMGFILE" ]]; then
        gwenview "$IMGFILE" &
        GWENVIEW_PID=$!
    else
        notify-send "Graph Error" "Failed to generate graph image."
        exit 1
    fi
else
    notify-send "Error" "gwenview not found."
    exit 1
fi

# Main Loop: Update Graph
while kill -0 "$GWENVIEW_PID" 2> /dev/null; do
    sleep 2
    generate_graph
done
