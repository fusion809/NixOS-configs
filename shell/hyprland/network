#!/usr/bin/env zsh

INTERFACE="enp24s0"
MODE="${1:-both}"
STATE_FILE="/tmp/waybar_network_state_$MODE"

# Get current stats
rx_now=$(cat /sys/class/net/$INTERFACE/statistics/rx_bytes)
tx_now=$(cat /sys/class/net/$INTERFACE/statistics/tx_bytes)
time_now=$(date +%s%N)

# Read previous state
if [[ -f $STATE_FILE ]]; then
    read rx_prev tx_prev time_prev < $STATE_FILE
else
    rx_prev=$rx_now
    tx_prev=$tx_now
    time_prev=$time_now
fi

# Calculate deltas
rx_delta=$((rx_now - rx_prev))
tx_delta=$((tx_now - tx_prev))
time_delta=$((time_now - time_prev))

# Avoid division by zero
if (( time_delta == 0 )); then
    time_delta=1000000000
fi

# Calculate speed in bytes per second
# time_delta is in nanoseconds, so multiply bytes by 1e9
rx_speed=$(( (rx_delta * 1000000000) / time_delta ))
tx_speed=$(( (tx_delta * 1000000000) / time_delta ))

# Save current state
echo "$rx_now $tx_now $time_now" > $STATE_FILE

# Function to format speed (bits/sec)
format_speed() {
    local bytes=$1
    local bits=$((bytes * 8))
    
    if (( bits < 1000 )); then
        echo "${bits}b"
    elif (( bits < 1000000 )); then
        printf "%.1fk" $((bits / 1000.0))
    elif (( bits < 1000000000 )); then
        printf "%.1fM" $((bits / 1000000.0))
    else
        printf "%.1fG" $((bits / 1000000000.0))
    fi
}

rx_fmt=$(format_speed $rx_speed)
tx_fmt=$(format_speed $tx_speed)

# Determine class based on speed thresholds
crit_speed_rx=10485760
crit_speed_tx=$(($crit_speed_rx/2))
high_speed_rx=1048576
high_speed_tx=$(($high_speed_rx/2))
medium_speed_rx=104858
medium_speed_tx=$(($medium_speed_rx/2))
low_speed_rx=10486
low_speed_tx=$(($low_speed_rx/2))

get_class_rx() {
    local speed=$1  
    if (( speed > crit_speed_rx )); then
        echo "critical"
    elif (( speed > high_speed_rx )); then
        echo "high"
    elif (( speed > medium_speed_rx )); then
        echo "medium"
    elif (( speed > low_speed_rx )); then
        echo "low"
    else
        echo "idle"
    fi
}

get_class_tx() {
    local speed=$1  
    if (( speed > crit_speed_rx )); then
        echo "critical"
    elif (( speed > high_speed_rx )); then
        echo "high"
    elif (( speed > medium_speed_rx )); then
        echo "medium"
    elif (( speed > low_speed_rx )); then
        echo "low"
    else
        echo "idle"
    fi
}

rx_class=$(get_class_rx $rx_speed)
tx_class=$(get_class_tx $tx_speed)

if [[ "$MODE" == "up" ]]; then
    printf '{"text":" %s","class":"%s"}' "$tx_fmt" "$tx_class"
elif [[ "$MODE" == "down" ]]; then
    printf '{"text":" %s","class":"%s"}' "$rx_fmt" "$rx_class"
else
    # Legacy/Both mode - use max class? Or just rx class as primary?
    # Original logic used max of both.
    if (( rx_speed > tx_speed )); then
        class=$rx_class
    else
        class=$tx_class
    fi
    printf '{"text":" %s  %s","class":"%s"}' "$tx_fmt" "$rx_fmt" "$class"
fi
