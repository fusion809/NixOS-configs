#!/usr/bin/env bash
NIXCFG="$HOME/GitHub/mine/config/NixOS-configs"
CONFIG_BASE="$NIXCFG/dotfiles/waybar-config.jsonc"
STYLE="$NIXCFG/dotfiles/style.css"

MONITOR=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .name')
TEMP_CONFIG="/tmp/waybar-config-$MONITOR.jsonc"

# Check for a waybar process specifically managing this monitor's config
if pgrep -f "$TEMP_CONFIG" > /dev/null; then
    pkill -f "$TEMP_CONFIG"
else
    # Extract config for this monitor
    sed 's/\/\/.*//g' "$CONFIG_BASE" | jq ".[] | select(.output == \"$MONITOR\")" > "$TEMP_CONFIG"
    # Start it with the specific config
    waybar -c "$TEMP_CONFIG" -s "$STYLE" &
fi
