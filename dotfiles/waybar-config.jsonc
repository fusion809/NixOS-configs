[
    // HDMI Monitor
    {
        "output": "HDMI-A-1",
        "layer": "top",
        "exclusive": true,
        "spacing": 4,
        "include": ["/home/fusion809/GitHub/mine/config/NixOS-configs/dotfiles/waybar-modules.jsonc"],
        "modules-left": [
            "custom/nixosicon",
            "hyprland/workspaces",
            "custom/weather",
            "custom/keyboard-layout",
            "pulseaudio",
            "custom/wallpaper-no",
            "custom/wallpaper-rm",
            "custom/wallpaper-previous",
            "custom/wallpaper-random",
            "custom/wallpaper-next",
            "custom/wallpaper-no-specify"
        ],
        "modules-center": [
            "hyprland/window"
        ],
        "modules-right": [
            "custom/temperature",
            "custom/root",
            "custom/arch",
            "custom/data",
            "custom/network-down",
            "custom/network-up",
            "custom/cpu",
            "custom/memory",
            "custom/gpu-memory",
            "custom/gpu-utilization",
            "custom/updates",
            "custom/clock"
        ]
    },
    // DVI Monitor
    {
        "output": "DVI-D-1",
        "layer": "top",
        "exclusive": true,
        "spacing": 4,
        "include": ["/home/fusion809/GitHub/mine/config/NixOS-configs/dotfiles/waybar-modules.jsonc"],
        "modules-left": [
