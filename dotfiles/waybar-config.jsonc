            "custom/wallpaper-next",
            "custom/wallpaper-no-specify"
        ],
        "modules-center": [
            "hyprland/window"
        ],
        "modules-right": [
            "custom/temperature",
            "custom/root",
            "custom/arch",
            "custom/data",
            "custom/network-down",
            "custom/network-up",
            "custom/cpu",
            "custom/memory",
            "custom/gpu-memory",
